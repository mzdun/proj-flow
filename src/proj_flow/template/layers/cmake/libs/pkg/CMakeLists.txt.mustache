configure_file({{SRCDIR}}/version{{EXT.hxx}}.in {{INCLUDEDIR}}/version{{EXT.hxx}} @ONLY)

set(SRCS
  {{INCLUDEDIR}}/helper{{EXT.hxx}}
  {{SRCDIR}}/helper{{EXT.cxx}}
)

set(GEN_SRCS
  "${CMAKE_CURRENT_BINARY_DIR}/{{INCLUDEDIR}}/version{{EXT.hxx}}"
)

source_group(TREE ${CMAKE_CURRENT_SOURCE_DIR} FILES ${SRCS})
source_group(TREE ${CMAKE_CURRENT_BINARY_DIR} PREFIX gen FILES ${GEN_SRCS})

{{#cmake.application}}
add_library({{LIB_NAME}} STATIC ${SRCS} ${GEN_SRCS})
{{/cmake.application}}
{{#cmake.library}}
{{cmake.cmd}}({{LIB_NAME}}{{cmake.type}} ${SRCS} ${GEN_SRCS})
{{/cmake.library}}

target_compile_options({{LIB_NAME}} PRIVATE {{${}}{{NAME_PREFIX}}_ADDITIONAL_COMPILE_FLAGS})
target_link_options({{LIB_NAME}} PUBLIC {{${}}{{NAME_PREFIX}}_ADDITIONAL_LINK_FLAGS})
target_include_directories({{LIB_NAME}}
  PUBLIC
    ${CMAKE_CURRENT_SOURCE_DIR}/include
    ${CMAKE_CURRENT_BINARY_DIR}/include
  PRIVATE
    ${CMAKE_CURRENT_SOURCE_DIR}/src
    ${CMAKE_CURRENT_BINARY_DIR}/src
)
{{#with.conan}}
target_link_libraries({{LIB_NAME}} PRIVATE mbits::args)
{{/with.conan}}
set_target_properties({{LIB_NAME}} PROPERTIES
  VERSION ${PROJECT_VERSION_MAJOR}.${PROJECT_VERSION_MINOR}
{{#cmake.shared}}
  SOVERSION ${PROJECT_VERSION_MAJOR}
  WINDOWS_EXPORT_ALL_SYMBOLS ON
{{/cmake.shared}}
{{#cmake.plugin}}
  SOVERSION ${PROJECT_VERSION_MAJOR}
{{/cmake.plugin}}
)

{{#cmake.library}}
##################################################################
##  INSTALL
##################################################################

if ({{NAME_PREFIX}}_INSTALL)
  install(TARGETS {{LIB_NAME}})
endif()

{{/cmake.library}}
##################################################################
##  TESTING
##################################################################

if ({{NAME_PREFIX}}_TESTING)
  set(TEST_SRCS
    tests/test{{EXT.cxx}}
  )
  source_group(TREE ${CMAKE_CURRENT_SOURCE_DIR}/tests FILES ${TEST_SRCS})

  add_project_test({{LIB_NAME}} ${TEST_SRCS})
  target_link_libraries({{LIB_NAME}}-test PUBLIC GTest::gmock_main{{^cmake.plugin}} {{LIB_NAME}}{{/cmake.plugin}})

  add_test(NAME {{LIB_NAME}} COMMAND {{LIB_NAME}}-test "--gtest_output=xml:${TEST_REPORT_DIR}/{{LIB_NAME}}/${TEST_REPORT_FILE}")
endif()
